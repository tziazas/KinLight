@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IStringLocalizer<PortalStrings> L

<MudThemeProvider Theme="KinLightTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menu" />
        <MudText Typo="Typo.h6" Class="ml-2">@L[PortalStrings.AppName]</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Breakpoint="Breakpoint.Md">
        <MudNavMenu>
            <MudNavLink Href="portal/today" Icon="@Icons.Material.Filled.Today" Disabled="true">@L[PortalStrings.Nav_Today]</MudNavLink>
            <MudNavLink Href="portal/displays" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tv">@L[PortalStrings.Nav_Displays]</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
