@inject IStringLocalizer<PortalStrings> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <WidgetSettingsForm Settings="Settings" Definition="Definition" Languages="Languages" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@L[PortalStrings.Action_Cancel]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(Settings))">@L[PortalStrings.Dialog_Ok]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Dialog title (the widget's name).</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>A copy of the settings to edit; returned on OK.</summary>
    [Parameter, EditorRequired]
    public required object Settings { get; set; }

    /// <summary>The widget.</summary>
    [Parameter, EditorRequired]
    public required IWidgetDefinition Definition { get; set; }

    /// <summary>Languages for LocalizedText fields.</summary>
    [Parameter]
    public IReadOnlyList<string> Languages { get; set; } = ["en"];
}
