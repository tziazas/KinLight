<Router AppAssembly="typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(KinLight.Modules.Display.Client.Pages.DisplayPage).Assembly, typeof(KinLight.Modules.Portal.Client.Pages.DisplaysPage).Assembly, typeof(KinLight.Modules.Widgets.Photos.Portal.PhotosPage).Assembly, typeof(KinLight.Modules.Widgets.Medication.Portal.MedicationsPage).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        @* The display at / never shows an error; an unknown URL goes back to it. *@
        <NavigateToRoot />
    </NotFound>
</Router>
